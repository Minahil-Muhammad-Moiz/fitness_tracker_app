<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/gradient_header_bg"
            android:padding="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/greetingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hi, Athlete! 👋"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Let's crush today's goal"
                android:textSize="14sp"
                android:textColor="#FFF3EC"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- STATS GRID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ROW 1: Steps + Calories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- STEPS CARD -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👣 Steps"
                        android:textSize="13sp"
                        android:textColor="#757575" />

                    <TextView
                        android:id="@+id/stepsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6,482"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Goal: 10,000"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E" />

                </LinearLayout>

                <!-- CALORIES CARD -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginStart="8dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 Calories"
                        android:textSize="13sp"
                        android:textColor="#757575" />

                    <TextView
                        android:id="@+id/caloriesValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="412"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="kcal burned"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E" />

                </LinearLayout>

            </LinearLayout>

            <!-- ROW 2: Water + Workout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- WATER CARD -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💧 Water"
                        android:textSize="13sp"
                        android:textColor="#757575" />

                    <TextView
                        android:id="@+id/waterValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.2L"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Goal: 2.5L"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E" />

                </LinearLayout>

                <!-- WORKOUT CARD -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:layout_marginStart="8dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️ Workout"
                        android:textSize="13sp"
                        android:textColor="#757575" />

                    <TextView
                        android:id="@+id/workoutValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28 min"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="today"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E" />

                </LinearLayout>

            </LinearLayout>

            <!-- ROW 3: Sleep Card (NEW) - Takes full width -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- SLEEP CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="16dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😴 Sleep"
                        android:textSize="13sp"
                        android:textColor="#757575" />

                    <TextView
                        android:id="@+id/sleepValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 hrs"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Goal: 8.0 hrs"
                        android:textSize="11sp"
                        android:textColor="#9E9E9E" />

                </LinearLayout>

            </LinearLayout>

            <!-- LOG WATER BUTTON -->
            <Button
                android:id="@+id/logWaterButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="+ Log a Glass of Water"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_primary_bg" />

            <!-- START WORKOUT BUTTON -->
            <Button
                android:id="@+id/startWorkoutButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="🏋️ Start a Workout"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FF6B35"
                android:background="@drawable/button_outline_bg" />

            <!-- LOG SLEEP BUTTON (NEW) -->
            <Button
                android:id="@+id/logSleepButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:text="😴 Log Sleep (+0.5 hrs)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_sleep_bg" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>